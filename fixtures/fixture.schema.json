{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fightbox.dev/schema/fixture-1.json",
  "title": "Fightbox controlled acoustic fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "gate", "coordinate_frame", "kernel", "source", "listener", "geometry", "simulation", "expected"],
  "properties": {
    "schema_version": {"const": "fightbox.fixture.v1"},
    "fixture_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "gate": {"enum": ["S0", "S1", "S2", "S3"]},
    "coordinate_frame": {"$ref": "#/$defs/coordinate_frame"},
    "kernel": {"$ref": "#/$defs/kernel"},
    "source": {"$ref": "#/$defs/source"},
    "listener": {"$ref": "#/$defs/listener"},
    "geometry": {"$ref": "#/$defs/geometry"},
    "simulation": {"$ref": "#/$defs/simulation"},
    "expected": {"$ref": "#/$defs/expected"}
  },
  "allOf": [
    {
      "if": {"properties": {"gate": {"const": "S3"}}},
      "then": {
        "properties": {
          "simulation": {"required": ["probe_volume", "probe_generation", "path_bake"]}
        }
      }
    }
  ],
  "$defs": {
    "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "coordinate_frame": {"type": "object", "additionalProperties": false, "required": ["name", "units", "axes", "steam_audio_mapping"], "properties": {"name": {"const": "local_enu"}, "units": {"const": "meters_seconds"}, "axes": {"const": "x_east_y_north_z_up"}, "steam_audio_mapping": {"const": "steam_x=enu_x;steam_y=enu_z;steam_z=-enu_y"}}},
    "kernel": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"const": "Steam Audio"}, "version": {"const": "4.8.1"}}},
    "extent": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "point"}}}, {"type": "object", "additionalProperties": false, "required": ["kind", "count"], "properties": {"kind": {"const": "multi_point"}, "count": {"type": "integer", "minimum": 1}}}, {"type": "object", "additionalProperties": false, "required": ["kind", "length_m"], "properties": {"kind": {"const": "line_segment"}, "length_m": {"type": "number", "exclusiveMinimum": 0}}}, {"type": "object", "additionalProperties": false, "required": ["kind", "width_m"], "properties": {"kind": {"const": "stereo_image"}, "width_m": {"type": "number", "exclusiveMinimum": 0}}}]},
    "source_trajectory": {"type": "object", "additionalProperties": false, "required": ["waypoints_m", "speed_mps", "max_speed_mps", "closed_cycle"], "properties": {"waypoints_m": {"type": "array", "items": {"$ref": "#/$defs/vec3"}, "minItems": 2}, "speed_mps": {"type": "number", "exclusiveMinimum": 0}, "max_speed_mps": {"type": "number", "exclusiveMinimum": 0}, "closed_cycle": {"const": true}}, "$comment": "The listening-scene parser additionally enforces speed_mps <= max_speed_mps."},
    "source_generator": {"type": "object", "additionalProperties": false, "required": ["kind", "fixed_seed"], "properties": {"kind": {"const": "firework_burst"}, "fixed_seed": {"const": "0xf1ae202607290048"}}},
    "walk_line_approach": {"type": "object", "additionalProperties": false, "required": ["kind", "name", "from_m", "to_m"], "properties": {"kind": {"const": "line"}, "name": {"const": "approach"}, "from_m": {"$ref": "#/$defs/vec3"}, "to_m": {"$ref": "#/$defs/vec3"}}},
    "walk_orbit": {"type": "object", "additionalProperties": false, "required": ["kind", "name", "center_m", "radius_m", "start_angle_degrees", "revolutions", "direction"], "properties": {"kind": {"const": "orbit"}, "name": {"const": "orbit"}, "center_m": {"$ref": "#/$defs/vec3"}, "radius_m": {"type": "number", "exclusiveMinimum": 0}, "start_angle_degrees": {"const": 0}, "revolutions": {"type": "number", "exclusiveMinimum": 0}, "direction": {"const": "counterclockwise"}}},
    "walk_line_recede": {"type": "object", "additionalProperties": false, "required": ["kind", "name", "from_m", "to_m"], "properties": {"kind": {"const": "line"}, "name": {"const": "recede"}, "from_m": {"$ref": "#/$defs/vec3"}, "to_m": {"$ref": "#/$defs/vec3"}}},
    "walk_trajectory": {"type": "object", "additionalProperties": false, "required": ["speed_mps", "segments"], "properties": {"speed_mps": {"type": "number", "exclusiveMinimum": 0}, "segments": {"type": "array", "prefixItems": [{"$ref": "#/$defs/walk_line_approach"}, {"$ref": "#/$defs/walk_orbit"}, {"$ref": "#/$defs/walk_line_recede"}], "minItems": 3, "maxItems": 3}}, "$comment": "The Tom's Diner parser additionally requires approach.to_m to equal recede.from_m."},
    "source": {"type": "object", "additionalProperties": false, "required": ["id", "reference_level"], "properties": {"id": {"type": "string"}, "position_m": {"$ref": "#/$defs/vec3"}, "trajectory": {"$ref": "#/$defs/source_trajectory"}, "reference_level": {"type": "object", "additionalProperties": false, "required": ["mode", "db_spl"], "properties": {"mode": {"const": "SplAtOneMeter"}, "db_spl": {"type": "number"}}}, "asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Identifier of the deterministic asset descriptor under fixtures/assets that this source plays. The descriptor supplies the decoded program RMS that the scene-owned source drive (ADR 0002) scales; the fixture records no duplicated asset calibration."}, "generator": {"$ref": "#/$defs/source_generator"}, "directivity": {"type": "object", "additionalProperties": false, "required": ["dipole_weight", "dipole_power"], "properties": {"dipole_weight": {"type": "number", "minimum": 0, "maximum": 1}, "dipole_power": {"type": "number", "minimum": 0.25, "maximum": 16}}}, "extent": {"$ref": "#/$defs/extent"}, "spatial_extent": {"const": "point", "deprecated": true, "description": "Legacy point-only spelling consumed by the Tom's Diner walk parser."}}, "allOf": [{"oneOf": [{"required": ["position_m"]}, {"required": ["trajectory"]}]}, {"oneOf": [{"required": ["asset_id"]}, {"required": ["generator"]}]}], "not": {"required": ["extent", "spatial_extent"]}},
    "listener": {"type": "object", "additionalProperties": false, "required": ["position_m", "forward_enu", "up_enu"], "properties": {"position_m": {"$ref": "#/$defs/vec3"}, "forward_enu": {"$ref": "#/$defs/vec3"}, "up_enu": {"$ref": "#/$defs/vec3"}, "trajectory_m": {"type": "array", "items": {"$ref": "#/$defs/vec3"}, "minItems": 2}, "orientation": {"const": "face_source"}, "trajectory": {"$ref": "#/$defs/walk_trajectory"}}, "dependentRequired": {"orientation": ["trajectory"], "trajectory": ["orientation"]}},
    "geometry": {"type": "object", "additionalProperties": false, "required": ["vertices_m", "triangles", "materials"], "properties": {"vertices_m": {"type": "array", "items": {"$ref": "#/$defs/vec3"}}, "triangles": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["indices", "material"], "properties": {"indices": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 3, "maxItems": 3}, "material": {"type": "string"}}}}, "materials": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["absorption", "scattering", "transmission"], "properties": {"absorption": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 3, "maxItems": 3}, "scattering": {"type": "number", "minimum": 0, "maximum": 1}, "transmission": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 3, "maxItems": 3}}}}}},
    "simulation": {"type": "object", "additionalProperties": false, "required": ["direct", "reflections", "pathing"], "properties": {"direct": {"type": "object", "additionalProperties": false, "required": ["distance_attenuation", "occlusion"], "properties": {"distance_attenuation": {"type": "boolean"}, "occlusion": {"type": "boolean"}, "occlusion_samples": {"type": "integer", "minimum": 1}}}, "reflections": {"type": "object", "additionalProperties": false, "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}, "rays": {"type": "integer", "minimum": 1}, "bounces": {"type": "integer", "minimum": 0}, "duration_s": {"type": "number", "exclusiveMinimum": 0}}}, "pathing": {"type": "object", "additionalProperties": false, "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}, "order": {"type": "integer", "minimum": 0}, "validation": {"type": "boolean"}, "alternate_paths": {"type": "boolean"}, "runtime_order": {"type": "array", "items": {"enum": ["direct", "path", "reflections"]}, "minItems": 1, "uniqueItems": true}}}, "air_absorption": {"type": "object", "additionalProperties": false, "required": ["enabled", "comparison"], "properties": {"enabled": {"type": "boolean"}, "comparison": {"type": "string"}}}, "probe_volume": {"type": "object", "additionalProperties": false, "required": ["type", "min_m", "max_m", "spacing_m"], "properties": {"type": {"const": "box"}, "min_m": {"$ref": "#/$defs/vec3"}, "max_m": {"$ref": "#/$defs/vec3"}, "spacing_m": {"type": "number", "exclusiveMinimum": 0}}}, "probe_generation": {"type": "object", "additionalProperties": false, "required": ["type", "height_m"], "properties": {"type": {"const": "uniform_floor"}, "height_m": {"type": "number", "exclusiveMinimum": 0}}}, "path_bake": {"type": "object", "additionalProperties": false, "required": ["identifier", "required_call", "probe_batch_serialization", "fresh_process_reload", "bake_order"], "properties": {"identifier": {"type": "string"}, "required_call": {"const": "iplPathBakerBake"}, "probe_batch_serialization": {"const": "required"}, "fresh_process_reload": {"const": true}, "bake_order": {"type": "integer", "minimum": 0}, "visibility_range_m": {"type": "number", "exclusiveMinimum": 0}, "path_range_m": {"type": "number", "exclusiveMinimum": 0}}}}},
    "expected": {"type": "object", "additionalProperties": false, "required": ["properties", "non_claims"], "properties": {"properties": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "non_claims": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "analytic": {"type": "object", "additionalProperties": false, "required": ["edge_m", "listener_to_edge_enu", "arrival_azimuth_degrees_clockwise_from_north", "tolerance_degrees", "meaning"], "properties": {"edge_m": {"$ref": "#/$defs/vec3"}, "listener_to_edge_enu": {"$ref": "#/$defs/vec3"}, "arrival_azimuth_degrees_clockwise_from_north": {"type": "number", "minimum": 0, "exclusiveMaximum": 360}, "tolerance_degrees": {"type": "number", "exclusiveMinimum": 0}, "meaning": {"type": "string"}}}, "stems": {"type": "object", "additionalProperties": false, "required": ["required", "pathing_toggle_captures"], "properties": {"required": {"type": "array", "items": {"enum": ["direct", "path", "reflections"]}, "minItems": 1, "uniqueItems": true}, "pathing_toggle_captures": {"type": "array", "items": {"enum": ["on", "off"]}, "minItems": 2, "uniqueItems": true}}}}}
  }
}
