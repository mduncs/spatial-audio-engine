{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fightbox.dev/schema/fixture-workbench-1.json",
  "title": "Fightbox workbench consumed fixture format",
  "description": "Only fields read by tools/fightbox-workbench. Additional properties are ignored by the Rust loader and reported as warnings by tools/validate.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sources",
    "listener",
    "simulation"
  ],
  "properties": {
    "fixture_id": {
      "type": "string",
      "minLength": 1
    },
    "air": {
      "$ref": "#/$defs/air"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "cues": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/cue" }
    },
    "events": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/ballistic_shot_event"
      }
    },
    "street_lines_m": {
      "description": "Display-only street centerlines in local ENU metres (east, north).",
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number" }
        }
      }
    },
    "street_names": {
      "description": "Display-only street names, parallel to street_lines_m; an empty string is unnamed.",
      "type": "array",
      "items": { "type": "string" }
    },
    "street_kinds": {
      "description": "Display-only OSM highway kinds, parallel to street_lines_m.",
      "type": "array",
      "items": { "type": "string" }
    },
    "listener": {
      "$ref": "#/$defs/listener"
    },
    "simulation": {
      "$ref": "#/$defs/simulation"
    },
    "audition": {
      "$ref": "#/$defs/audition"
    }
  },
  "$defs": {
    "air": {
      "oneOf": [
        {
          "enum": ["temperate", "cold_dry", "hot_humid", "warm_dry"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["temperature_c", "relative_humidity_percent"],
          "properties": {
            "temperature_c": {"type": "number", "minimum": -20, "maximum": 50},
            "relative_humidity_percent": {"type": "number", "minimum": 10, "maximum": 100},
            "pressure_kpa": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 3.4028234663852886e+38,
              "default": 101.325
            }
          }
        }
      ],
      "description": "Scene air changes distance tone only. Omitted air uses the bit-identical temperate fallback."
    },
    "cue_zone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "center_m",
        "radius_m"
      ],
      "properties": {
        "center_m": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "cue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at_s",
            "play"
          ],
          "properties": {
            "at_s": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 384307168202282.3
            },
            "play": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at_s",
            "stop"
          ],
          "properties": {
            "at_s": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 384307168202282.3
            },
            "stop": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "when_listener_enters",
            "play"
          ],
          "properties": {
            "when_listener_enters": {
              "$ref": "#/$defs/cue_zone"
            },
            "play": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "minimum": -3.4028234663852886e+38,
        "maximum": 3.4028234663852886e+38
      }
    },
    "reference_level": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "db_spl"
      ],
      "properties": {
        "mode": {
          "const": "SplAtOneMeter"
        },
        "db_spl": {
          "type": "number",
          "minimum": -3.4028234663852886e+38,
          "maximum": 3.4028234663852886e+38
        }
      }
    },
    "directivity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dipole_weight",
        "dipole_power"
      ],
      "properties": {
        "dipole_weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dipole_power": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 16
        }
      }
    },
    "point_extent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "point"
        }
      }
    },
    "multi_point_extent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "count"
      ],
      "properties": {
        "kind": {
          "const": "multi_point"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        }
      }
    },
    "line_extent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "length_m"
      ],
      "properties": {
        "kind": {
          "const": "line_segment"
        },
        "length_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3.4028234663852886e+38
        }
      }
    },
    "stereo_extent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "width_m"
      ],
      "properties": {
        "kind": {
          "const": "stereo_image"
        },
        "width_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3.4028234663852886e+38
        }
      }
    },
    "extent": {
      "oneOf": [
        {
          "$ref": "#/$defs/point_extent"
        },
        {
          "$ref": "#/$defs/multi_point_extent"
        },
        {
          "$ref": "#/$defs/line_extent"
        },
        {
          "$ref": "#/$defs/stereo_extent"
        }
      ]
    },
    "trajectory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "waypoints_m",
        "speed_mps"
      ],
      "properties": {
        "waypoints_m": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/vec3"
          }
        },
        "speed_mps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3.4028234663852886e+38
        },
        "max_speed_mps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3.4028234663852886e+38
        }
      },
      "$comment": "The Rust loader additionally enforces speed_mps <= max_speed_mps when max_speed_mps is present."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reference_level"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "program_file": {
          "type": "string",
          "minLength": 1,
          "description": "Song path, absolute or relative to this fixture; macOS decodes to 48 kHz and measured nominal -14 dBFS. Starts off and loops; stereo requires stereo_image extent."
        },
        "live_input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["device"],
          "properties": {
            "device": {"type": "string", "minLength": 1},
            "channels": {
              "enum": ["mono", "stereo"],
              "default": "mono",
              "description": "Program plane count; stereo live input requires a StereoImage extent."
            },
            "song": {
              "type": "string",
              "minLength": 1,
              "description": "Optional song path, absolute or relative to this fixture, played until an app or device is chosen."
            }
          },
          "description": "Live loopback input; uses nominal -14 dBFS program RMS. Mono is the default."
        },
        "reference_level": {
          "$ref": "#/$defs/reference_level"
        },
        "default_enabled": {
          "type": "boolean"
        },
        "impulsive": {
          "type": "boolean",
          "default": false,
          "description": "Explicitly opts this source into onset-scheduled echo taps when its asset descriptor carries onsets_s. Defaults false in the Rust loader."
        },
        "monitor_offset_db": {
          "type": "number",
          "minimum": -24,
          "maximum": 24
        },
        "playback_start_offset_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 3.4028234663852886e+38,
          "default": 0,
          "description": "Initial phase of a looping source asset in seconds. Sources with the same value remain sample-synchronized."
        },
        "restart_on_enable": {
          "type": "boolean",
          "default": false,
          "description": "When true, disabled playback is silent and rewinds to playback_start_offset_s so the next enable begins at the declared phase. Existing fixtures default to free-running loops."
        },
        "directivity": {
          "$ref": "#/$defs/directivity"
        },
        "extent": {
          "$ref": "#/$defs/extent"
        },
        "position_m": {
          "$ref": "#/$defs/vec3"
        },
        "trajectory": {
          "$ref": "#/$defs/trajectory"
        },
        "audition_label": {
          "type": "string",
          "minLength": 1
        },
        "macro_range_m": {
          "enum": [
            100,
            1000,
            10000
          ]
        },
        "ballistic": {
          "$ref": "#/$defs/source_ballistic"
        },
        "gunfire": {
          "$ref": "#/$defs/source_gunfire"
        }
      },
      "oneOf": [
        {"required": ["asset_id"], "not": {"anyOf": [{"required": ["live_input"]}, {"required": ["program_file"]}]}},
        {"required": ["live_input"], "not": {"anyOf": [{"required": ["asset_id"]}, {"required": ["program_file"]}]}},
        {"required": ["program_file"], "not": {"anyOf": [{"required": ["asset_id"]}, {"required": ["live_input"]}]}}
      ],
      "allOf": [{
        "if": {
          "required": ["live_input"],
          "properties": {"live_input": {
            "required": ["channels"],
            "properties": {"channels": {"const": "stereo"}}
          }}
        },
        "then": {
          "required": ["extent"],
          "properties": {"extent": {"properties": {"kind": {"const": "stereo_image"}}}}
        }
      }],
      "if": {"anyOf": [{"required": ["live_input"]}, {"required": ["program_file"]}]},
      "then": {
        "required": ["default_enabled"],
        "properties": {
          "default_enabled": {"const": false},
          "impulsive": {"const": false},
          "playback_start_offset_s": {"const": 0}
        },
        "not": {"anyOf": [{"required": ["ballistic"]}, {"required": ["gunfire"]}]}
      },
      "anyOf": [
        {
          "required": [
            "position_m"
          ]
        },
        {
          "required": [
            "trajectory"
          ]
        }
      ]
    },
    "source_gunfire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aim_point_m", "muzzle_velocity_mps", "supersonic_distance_m", "dispersion_m", "crack_peak_db_at_30_m"],
      "properties": {
        "aim_point_m": {"$ref": "#/$defs/vec3"},
        "muzzle_velocity_mps": {"type": "number", "exclusiveMinimum": 0},
        "supersonic_distance_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000},
        "dispersion_m": {"type": "number", "minimum": 0, "maximum": 5},
        "round_aim_offsets_m": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"type": "number", "minimum": -100, "maximum": 100}, "description": "Signed lateral aim-plane offsets, one per detected round; repeats with loop phase. Load rejects count mismatch."},
        "street_response": {"type": "boolean", "default": true, "description": "The existing companion sends its N-wave to the first 125 ms of Steam reflections (both native simulation and convolution IR are capped; original rays and bounces are retained) from its apparent tangent point. Static companion simulation updates use one fifth of the ordinary cadence; movement forces a refresh. Two active companions within 3 m can share the existing street field and convolver; their direct paths remain independent. Gun reflections and the direct N-wave are unchanged. False selects a dry comparison."},
        "crack_peak_db_at_30_m": {"type": "number", "minimum": 0, "maximum": 200},
        "n_wave_ms_at_30_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
        "notes": {"type": "string"}
      },
      "$comment": "The Rust loader additionally requires a static, default-off looping muzzle asset with restart_on_enable, zero playback offset, no live input/program_file/ballistic block, and one companion slot within MAX_ACTIVE_SOURCES. Every round is detected at load independently of descriptor onsets_s; no manual trigger. Velocity and received peak anchor need fixture-owned provenance. The finite constant-speed flight reuses the piecewise Mach planner."
    },
    "source_ballistic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "muzzle_position_m",
        "mach_segments",
        "crack_peak_db_at_30_m"
      ],
      "properties": {
        "muzzle_position_m": {
          "$ref": "#/$defs/vec3",
          "description": "Start of the modelled straight flight (a terminal segment may start in the air). No muzzle blast is rendered from it."
        },
        "mach_segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "length_m",
              "mach"
            ],
            "properties": {
              "length_m": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "mach": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "n_wave_ms_at_30_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "N-wave duration at a 30 m perpendicular miss; scales as miss^(1/4). Defaults to the signed 0.8 ms small-arms anchor."
        },
        "crack_peak_db_at_30_m": {
          "type": "number",
          "minimum": 0,
          "maximum": 200,
          "description": "Received crack peak level at a 30 m perpendicular miss; falls as miss^(-3/4)."
        },
        "notes": {
          "type": "string"
        }
      },
      "$comment": "The Rust loader additionally requires the owning source to have position_m and no trajectory, the segment lengths to sum to |position_m - muzzle_position_m| within 0.1 m, and ordinary sources plus one crack slot per ballistic source to fit MAX_ACTIVE_SOURCES."
    },
    "event_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "default_active"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "default_active": {
          "const": false
        }
      }
    },
    "ballistic_event_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crack",
        "blast"
      ],
      "properties": {
        "crack": {
          "$ref": "#/$defs/event_source"
        },
        "blast": {
          "$ref": "#/$defs/event_source"
        }
      }
    },
    "ballistic_event_levels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blast_spl_at_one_meter_db",
        "crack_over_blast_db_at_30_m"
      ],
      "properties": {
        "blast_spl_at_one_meter_db": {
          "type": "number",
          "minimum": -3.4028234663852886e+38,
          "maximum": 3.4028234663852886e+38
        },
        "crack_over_blast_db_at_30_m": {
          "type": "number",
          "minimum": -3.4028234663852886e+38,
          "maximum": 3.4028234663852886e+38
        }
      }
    },
    "ballistic_shot_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "trigger_key",
        "event_sources",
        "muzzle_m",
        "direction_enu",
        "mach",
        "asset_id",
        "levels"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "ballistic_shot"
        },
        "trigger_key": {
          "const": "space"
        },
        "event_sources": {
          "$ref": "#/$defs/ballistic_event_sources"
        },
        "muzzle_m": {
          "$ref": "#/$defs/vec3"
        },
        "direction_enu": {
          "$ref": "#/$defs/vec3"
        },
        "mach": {
          "type": "number",
          "exclusiveMinimum": 1,
          "maximum": 3.4028234663852886e+38
        },
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "levels": {
          "$ref": "#/$defs/ballistic_event_levels"
        }
      }
    },
    "listener": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forward_enu"
      ],
      "properties": {
        "position_m": {
          "$ref": "#/$defs/vec3"
        },
        "trajectory": {
          "$ref": "#/$defs/trajectory"
        },
        "forward_enu": {
          "$ref": "#/$defs/vec3"
        }
      },
      "anyOf": [
        {
          "required": [
            "position_m"
          ]
        },
        {
          "required": [
            "trajectory"
          ]
        }
      ]
    },
    "direct": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "occlusion_samples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "reflections": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "bounces": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "duration_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3.4028234663852886e+38
        }
      }
    },
    "pathing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "validation": {
          "type": "boolean"
        },
        "alternate_paths": {
          "type": "boolean"
        },
        "visibility_range_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3.4028234663852886e+38
        }
      }
    },
    "probe_volume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spacing_m"
      ],
      "properties": {
        "spacing_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1.3611293865541154e+38
        }
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direct",
        "reflections",
        "pathing",
        "probe_volume"
      ],
      "properties": {
        "direct": {
          "$ref": "#/$defs/direct"
        },
        "reflections": {
          "$ref": "#/$defs/reflections"
        },
        "pathing": {
          "$ref": "#/$defs/pathing"
        },
        "probe_volume": {
          "$ref": "#/$defs/probe_volume"
        }
      }
    },
    "audition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "title",
        "place_label",
        "place_nonclaim",
        "macro_ranges_m"
      ],
      "properties": {
        "mode": {
          "enum": [
            "gamma_audition",
            "squad_palette"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "place_label": {
          "type": "string",
          "minLength": 1
        },
        "place_nonclaim": {
          "type": "string",
          "minLength": 1
        },
        "macro_ranges_m": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "const": 100
            },
            {
              "const": 1000
            },
            {
              "const": 10000
            }
          ],
          "items": false
        }
      }
    }
  }
}
