{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fightbox.dev/schema/fixture-s6a-1.json",
  "title": "Fightbox S6a multi-source acceptance fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "gate", "coordinate_frame", "kernel", "sources", "listener", "geometry", "simulation", "expected"],
  "properties": {
    "schema_version": {"const": "fightbox.fixture.s6a.v1"},
    "fixture_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "gate": {"enum": ["S5", "S6A"]},
    "coordinate_frame": {"$ref": "#/$defs/coordinate_frame"},
    "kernel": {"$ref": "#/$defs/kernel"},
    "sources": {"$ref": "#/$defs/sources"},
    "listener": {"$ref": "#/$defs/listener"},
    "geometry": {"$ref": "#/$defs/geometry"},
    "simulation": {"$ref": "#/$defs/simulation"},
    "expected": {"$ref": "#/$defs/expected"}
  },
  "$defs": {
    "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "coordinate_frame": {"type": "object", "additionalProperties": false, "required": ["name", "units", "axes", "steam_audio_mapping"], "properties": {"name": {"const": "local_enu"}, "units": {"const": "meters_seconds"}, "axes": {"const": "x_east_y_north_z_up"}, "steam_audio_mapping": {"const": "steam_x=enu_x;steam_y=enu_z;steam_z=-enu_y"}}},
    "kernel": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"const": "Steam Audio"}, "version": {"const": "4.8.1"}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["id", "asset_id", "reference_level"], "properties": {"id": {"type": "string"}, "asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "reference_level": {"type": "object", "additionalProperties": false, "required": ["mode", "db_spl"], "properties": {"mode": {"const": "SplAtOneMeter"}, "db_spl": {"type": "number"}}}, "position_m": {"$ref": "#/$defs/vec3"}, "trajectory": {"type": "object", "additionalProperties": false, "required": ["waypoints_m", "speed_mps", "max_speed_mps"], "properties": {"waypoints_m": {"type": "array", "items": {"$ref": "#/$defs/vec3"}, "minItems": 2}, "speed_mps": {"type": "number", "exclusiveMinimum": 0}, "max_speed_mps": {"type": "number"}}}, "directivity": {"type": "object", "additionalProperties": false, "required": ["dipole_weight", "dipole_power"], "properties": {"dipole_weight": {"type": "number", "minimum": 0, "maximum": 1}, "dipole_power": {"type": "number", "minimum": 0.25, "maximum": 16}}}}, "oneOf": [{"required": ["id", "asset_id", "reference_level", "position_m"]}, {"required": ["id", "asset_id", "reference_level", "trajectory"]}]},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}, "minItems": 1, "maxItems": 8},
    "listener": {"type": "object", "additionalProperties": false, "required": ["forward_enu", "up_enu"], "properties": {"position_m": {"$ref": "#/$defs/vec3"}, "trajectory": {"type": "object", "additionalProperties": false, "required": ["waypoints_m", "speed_mps", "max_speed_mps"], "properties": {"waypoints_m": {"type": "array", "items": {"$ref": "#/$defs/vec3"}, "minItems": 2}, "speed_mps": {"type": "number", "exclusiveMinimum": 0}, "max_speed_mps": {"type": "number"}}}, "forward_enu": {"$ref": "#/$defs/vec3"}, "up_enu": {"$ref": "#/$defs/vec3"}}, "oneOf": [{"required": ["position_m"]}, {"required": ["trajectory"]}]},
    "geometry": {"type": "object", "additionalProperties": false, "required": ["vertices_m", "triangles", "materials"], "properties": {"vertices_m": {"type": "array", "items": {"$ref": "#/$defs/vec3"}}, "triangles": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["indices", "material"], "properties": {"indices": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 3, "maxItems": 3}, "material": {"type": "string"}}}}, "materials": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["absorption", "scattering", "transmission"], "properties": {"absorption": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 3, "maxItems": 3}, "scattering": {"type": "number", "minimum": 0, "maximum": 1}, "transmission": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 3, "maxItems": 3}}}}}},
    "simulation": {"type": "object", "additionalProperties": false, "required": ["direct", "reflections", "pathing", "probe_volume", "probe_generation", "path_bake"], "properties": {"direct": {"type": "object", "additionalProperties": false, "required": ["distance_attenuation", "occlusion"], "properties": {"distance_attenuation": {"type": "boolean"}, "occlusion": {"type": "boolean"}, "occlusion_samples": {"type": "integer", "minimum": 1}}}, "reflections": {"type": "object", "additionalProperties": false, "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}, "rays": {"type": "integer", "minimum": 1}, "bounces": {"type": "integer", "minimum": 0}, "duration_s": {"type": "number", "exclusiveMinimum": 0}}}, "pathing": {"type": "object", "additionalProperties": false, "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}, "order": {"type": "integer", "minimum": 0}, "validation": {"type": "boolean"}, "alternate_paths": {"type": "boolean"}, "runtime_order": {"type": "array", "items": {"enum": ["direct", "path", "reflections"]}, "minItems": 1, "uniqueItems": true}}}, "air_absorption": {"type": "object", "additionalProperties": false, "required": ["enabled", "comparison"], "properties": {"enabled": {"type": "boolean"}, "comparison": {"type": "string"}}}, "probe_volume": {"type": "object", "additionalProperties": false, "required": ["type", "min_m", "max_m", "spacing_m"], "properties": {"type": {"const": "box"}, "min_m": {"$ref": "#/$defs/vec3"}, "max_m": {"$ref": "#/$defs/vec3"}, "spacing_m": {"type": "number", "exclusiveMinimum": 0}}}, "probe_generation": {"type": "object", "additionalProperties": false, "required": ["type", "height_m"], "properties": {"type": {"const": "uniform_floor"}, "height_m": {"type": "number", "exclusiveMinimum": 0}}}, "path_bake": {"type": "object", "additionalProperties": false, "required": ["identifier", "required_call", "probe_batch_serialization", "fresh_process_reload", "bake_order"], "properties": {"identifier": {"type": "string"}, "required_call": {"const": "iplPathBakerBake"}, "probe_batch_serialization": {"const": "required"}, "fresh_process_reload": {"const": true}, "bake_order": {"type": "integer", "minimum": 0}}}}},
    "expected": {"type": "object", "additionalProperties": false, "required": ["properties", "non_claims"], "properties": {"properties": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "non_claims": {"type": "array", "items": {"type": "string"}, "minItems": 1}}},
    "notes": "Schema constraints that JSON Schema cannot express: at most one source may carry a trajectory field; phase-b S6a specifically requires four sources, exactly one moving source, and a static listener; city render accepts one through eight sources and requires a source or listener trajectory to define the capture duration; any trajectory must have speed_mps <= max_speed_mps; all position_m and trajectory waypoints must be finite and lie within the simulation.probe_volume bounds; all referenced asset_ids must correspond to descriptors in fixtures/assets/."
  }
}
